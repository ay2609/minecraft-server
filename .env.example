BOT_NAME=Scout
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=Scout
MC_AUTH=offline
MC_VERSION=
RUNTIME_WS_HOST=0.0.0.0
RUNTIME_WS_PORT=8787

SNAPSHOT_INTERVAL_MS=1000
SALIENCE_MIN=0.15
# Event pipeline: lower = more responsive (entity moves, inventory updates)
ENTITY_MOVE_MIN_INTERVAL_MS=400
INVENTORY_COALESCE_MS=350
DANGER_RADIUS=8
ACTION_TIMEOUT_MS=15000
IDLE_BEHAVIOR=standby
REPEATED_FAILURE_WINDOW_MS=60000
REPEATED_FAILURE_THRESHOLD=3

BRAIN_RUNTIME_WS_URL=ws://127.0.0.1:8787
# Brain: lower = faster response, more LLM calls
REACTIVE_CADENCE_MS=1200
THINKING_CADENCE_MS=2000
THINKING_MIN_GAP_MS=600
CONTROL_DEDUP_WINDOW_MS=1000
REPLACE_QUEUE_MIN_GAP_MS=1500
CANCEL_MIN_GAP_MS=800

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Fireworks (OpenAI-compatible) — recommended for low latency:
# LLM_PROVIDER=fireworks
# OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
# OPENAI_MODEL=accounts/fireworks/models/deepseek-v3-0324
# Alternatives: accounts/fireworks/models/qwen3-30b-a3b, accounts/fireworks/models/llama4-maverick-instruct-basic

HOME_X=
HOME_Y=
HOME_Z=
